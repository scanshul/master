package StringBufferBuilder;

public class StringBufferThreadExample {
	
	public static void main(String[] args) {
		StringBuffer bf = new StringBuffer();
		ThreadTask tt1 = new ThreadTask(bf);
		Thread t1 = new Thread(tt1);
		Thread t2 = new Thread(tt1);
		Thread t3 = new Thread(tt1);
		t1.start();
		t2.start();
		t3.start();	
		
		t1.join();
		t2.join();
		t3.join();
		}

}

class ThreadTask implements Runnable{
	private StringBuffer stringBuffer;
	
	public ThreadTask(StringBuffer stringBuffer) {
		this.stringBuffer = stringBuffer;
		
	}

	@Override
	public void run() {
		for(int i = 1 ; i<=5 ; i++) {
			stringBuffer.append(Thread.currentThread().getName()).append(":").append(i).append("");
			try {
				Thread.sleep(100);
			} catch (InterruptedException e) {
				System.out.println(e);
			}
			System.out.println(stringBuffer.toString());
		}
	}
	
}
