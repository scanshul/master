package Comparasion;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

class Student implements Comparable<RoomRent> {

	private String sname;
	private int sid;

	public Student(String sname, int sid) {
		this.sid = sid;
		this.sname = sname;
	}

	public String getSname() {
		return sname;
	}

	public int getSid() {
		return sid;
	}

	@Override
	public int compareTo(RoomRent other) {
		//return this.sid - other.sid; //increasing order
		return other.sid - this.sid;
	}

	@Override
	public String toString() {
		return "Student [sname=" + sname + ", sid=" + sid + "]";
	}

}

public class ComparableInterface {
	public static void main(String[] args) {
		List<RoomRent> lst = new ArrayList<>();
		lst.add(new RoomRent("Sohan", 25));
		lst.add(new RoomRent("Kamalesh", 16));
		lst.add(new RoomRent("Mayur", 22));

		Collections.sort(lst);

		for (RoomRent s : lst) {
			System.out.println(s);
		}
	}

}
