package BasicConcepts;

public class OverloadingEg1 {
	public static void main(String[] args) {
		
		OverloadingEg1 ovg = new OverloadingEg1();
		ovg.m1(null);
		
	}
	
	public void m1(Object o) {
		System.out.println("This is Object class" + o);
	}
	
	public void m1(String s) {
		System.out.println("This is String class" +s);
	}
	
	public void m1(StringBuffer sb) {
		System.out.println("This is String buffer class" +sb);
	}
	
	public void m1(StringBuilder sbd) {
		System.out.println("This is String builder class" +sbd);
		
	}

}
