package ScenarioBased;

public class DuplicateNumberInArray {
	public static void main(String[] args) {
		int [] dup = new int []{5,8,6,1,5,0,7,1,3,8,5};
		int len = dup.length;
		boolean[] checked = new boolean[len];
		
		for(int i = 0; i<len;i++) {
			if(checked[i]) {
				continue;
				
			}
			boolean isDuplicate = false;
			int count = 1;
			for(int j =i+1; j< dup.length;j++) {
			if(dup[i] == dup[j]) {
				isDuplicate = true;
				count++;
				checked[j] = true;
			}
				
			}
			if (isDuplicate) {
				System.out.println(dup[i] + "Count : " + count);
				
			}
		}
	}

}
