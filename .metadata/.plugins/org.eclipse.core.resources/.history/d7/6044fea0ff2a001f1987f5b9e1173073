package ImmutableConcept;

public class ImmutableCaller {
	
	private int paymentId;
	private String name;
	
	private ImmutableCaller(int paymentId, String name) {
		this.paymentId = paymentId;
		this.name = name;
	}

	public int getPaymentId() {
		return paymentId;
	}

	public String getName() {
		return name;
	}
	
	
	public static void main(String[] args) {
		ImmutableCaller imu = new ImmutableCaller(12, "Raman");
		System.out.println(imu.getPaymentId());
		System.out.println(imu.getName());
		ImmutableCaller imu1 = new ImmutableCaller(15, "John");
		System.out.println(imu1.getPaymentId());
		System.out.println(imu1.getName());
		
	}

}
