package ScenarioBased;

public class DuplicateNumberInArray {
	public static void main(String[] args) {
		int [] dup = new int []{5,8,6,1,5};
		
		for(int i = 0; i<dup.length;i++) {
			for(int j =1+1; j< dup.length;j++) {
			if(dup[i] == dup[j]) {
				System.out.println(dup[j]);
			}
				
			}
		}
	}

}
