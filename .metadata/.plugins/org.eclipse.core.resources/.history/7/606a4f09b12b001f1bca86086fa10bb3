package ScenarioBased;

public class RemoveWhiteSpace {
public static void main(String[] args) {
	String st = "    Initializing Spring  sDispatcherServlet   dispatcherServlet   ";
	System.out.println(st.trim()); // Remove start and end space 
	System.out.println(st.replaceAll("\\s", "")); //Remove all space
}
}
